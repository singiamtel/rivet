BEGIN PLOT /ALICE_2021_I1848990/d01-x01-y01
Title=Differential cross section of non-prompt $D^0$ production
XLabel=$p_T$ [GeV/$c$]
YLabel=$\mathrm{d^2}\sigma/(\mathrm{d}p_T\mathrm{d}y)$ [$\mu$b/(GeV/c)]
ConnectBins=0
END PLOT

